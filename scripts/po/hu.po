#: scripts/makepkg.sh.in:141
msgid "Cleaning up..."
msgstr "Tisztítás…"

#: scripts/makepkg.sh.in:188
msgid "Entering %s environment..."
msgstr "Belépés a(z) %s környezetbe…"

#: scripts/makepkg.sh.in:195 scripts/makepkg.sh.in:421
msgid "Starting %s()..."
msgstr "A(z) %s() indítása…"

#: scripts/makepkg.sh.in:201
msgid "pkgver() generated an invalid version: %s"
msgstr "a pkgver() érvénytelen verziót állított elő: %s"

#: scripts/makepkg.sh.in:211
msgid "Failed to update %s from %s to %s"
msgstr "Nem sikerült frissíteni a következőt: %s erről: %s, erre: %s"

#: scripts/makepkg.sh.in:217
msgid "Updated version: %s"
msgstr "Frissített verzió: %s"

#: scripts/makepkg.sh.in:219
msgid "%s is not writeable -- pkgver will not be updated"
msgstr "A(z) %s nem írható -- a pkgver nem lesz frissítve"

#: scripts/makepkg.sh.in:227
msgid "Unable to find source file %s."
msgstr "Nem található a következő forrásfájl: %s."

#: scripts/makepkg.sh.in:228 scripts/makepkg.sh.in:370
#: scripts/makepkg.sh.in:582 scripts/makepkg.sh.in:1080
